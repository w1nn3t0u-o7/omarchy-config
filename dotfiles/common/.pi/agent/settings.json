{
  "theme": "omarchy-system",
  "lastChangelogVersion": "1.0.0",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "low",
  "packages": [
    "git:github.com/amosblomqvist/pi-observational-memory",
    "git:github.com/amosblomqvist/pi-interactive-subagents"
  ],
  "observational-memory": {
    "chunkTokens": 5000,
    "chunkOverlapTokens": 0,
    "poolTargetTokens": 10000,
    "consolidateAtPoolTokens": 20000,
    "compactAtContextTokens": 100000,
    "tailTokens": 20000,
    "journeyTargetTokens": 1000,
    "observerConcurrency": 4,
    "models": {
      "observer":     { "provider": "deepseek", "id": "deepseek-flash", "thinking": "low" },
      "consolidator": { "provider": "deepseek", "id": "deepseek-flash", "thinking": "high" }
    },
    "passive": false,
    "debugLog": false
  }
}
