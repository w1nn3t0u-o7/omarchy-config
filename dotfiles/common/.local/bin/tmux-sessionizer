#!/usr/bin/env bash
# tmux-sessionizer
#
# Fuzzy-pick a project directory and open (or attach to) a tmux session with a
# fixed set of windows: neovim, pi, a scratch shell, and lazygit.
#
# Commands are typed into each window's shell, so quitting an app leaves you in
# that window's shell instead of destroying the window.
#
# A project may contain a `.tmux-sessionizer` shell file that is sourced to
# override TS_WINDOWS (only use this in projects you trust).
#
# Usage: tmux-sessionizer [OPTIONS] [DIRECTORY|SESSION]
#
# Configuration: ~/.config/tmux-sessionizer/tmux-sessionizer.conf (optional;
# built-in defaults are used when it is missing).

set -uo pipefail

VERSION="0.3.1"

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-sessionizer/tmux-sessionizer.conf"

# Built-in defaults so the script can run standalone. A config file overrides
# any of these.
TS_SEARCH_PATHS=("$HOME/Projects")
TS_MAX_DEPTH=1
TS_WINDOWS=("nvim:nvim ." "term:")

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

[[ "$TS_MAX_DEPTH" =~ ^[0-9]+$ ]] || TS_MAX_DEPTH=1

if (( ${#TS_WINDOWS[@]} == 0 )); then
  echo "tmux-sessionizer: TS_WINDOWS is empty" >&2
  exit 1
fi

usage() {
  cat <<EOF
Usage: tmux-sessionizer [OPTIONS] [DIRECTORY|SESSION]

Fuzzy-pick a project directory with fzf and open a tmux session for it.

Options:
  -h, --help     Show this help
  -v, --version  Show version
EOF
}

while (( $# > 0 )); do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --version)
      echo "tmux-sessionizer $VERSION"
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      user_selected="$1"
      ;;
  esac
  shift
done

sanity_check() {
  local cmd
  for cmd in tmux fzf; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "$cmd is required but not installed." >&2
      exit 1
    fi
  done
}

switch_to() {
  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "$1"
  else
    tmux attach-session -t "$1"
  fi
}

has_session() {
  tmux has-session -t "=$1" 2>/dev/null
}

window_exists() {
  tmux list-windows -t "=$1" -F '#{window_name}' 2>/dev/null | grep -Fxq -- "$2"
}

# Type the command into the window's shell (rather than making it the window's
# process) so the window survives when the command exits.
run_in_window() {
  tmux send-keys -t "$1" -l "$2"
  tmux send-keys -t "$1" Enter
}

new_window() {
  local session="$1" dir="$2" spec="$3"
  local name="${spec%%:*}" cmd=""

  [[ "$spec" == *:* ]] && cmd="${spec#*:}"

  window_exists "$session" "$name" && return 0

  tmux new-window -d -t "$session:" -n "$name" -c "$dir"
  if [[ -n "$cmd" ]]; then
    run_in_window "$session:$name" "$cmd"
  fi
}

create_session() {
  local session="$1" dir="$2"
  local first="${TS_WINDOWS[0]}"
  local name="${first%%:*}" cmd="" i

  [[ "$first" == *:* ]] && cmd="${first#*:}"

  tmux new-session -ds "$session" -c "$dir" -n "$name"
  if [[ -n "$cmd" ]]; then
    run_in_window "$session:$name" "$cmd"
  fi

  for (( i = 1; i < ${#TS_WINDOWS[@]}; i++ )); do
    new_window "$session" "$dir" "${TS_WINDOWS[$i]}"
  done

  tmux select-window -t "$session:$name"
}

# Add any missing windows to an existing session and focus the main window.
ensure_layout() {
  local session="$1" dir="$2" spec
  local main="${TS_WINDOWS[0]%%:*}"

  for spec in "${TS_WINDOWS[@]}"; do
    new_window "$session" "$dir" "$spec"
  done

  tmux select-window -t "$session:$main" 2>/dev/null || true
}

# Source a project-local shell override. This is arbitrary code, so it is only
# for trusted projects; it usually replaces or appends to TS_WINDOWS.
apply_project_overrides() {
  local dir="$1" file="$1/.tmux-sessionizer"
  local -a global_windows

  [[ -f "$file" ]] || return 0

  global_windows=("${TS_WINDOWS[@]}")
  TS_PROJECT_DIR="$dir"

  # shellcheck source=/dev/null
  if ! source "$file"; then
    echo "tmux-sessionizer: failed to source $file; keeping the global layout" >&2
    TS_WINDOWS=("${global_windows[@]}")
    return 0
  fi

  if (( ${#TS_WINDOWS[@]} == 0 )); then
    echo "tmux-sessionizer: $file left TS_WINDOWS empty; keeping the global layout" >&2
    TS_WINDOWS=("${global_windows[@]}")
  fi
}

# Existing tmux sessions (except the current one) come first, then project dirs.
# A directory whose session already exists is skipped so the same project does
# not appear both as `[TMUX] name` and as a path. This includes the current
# session's directory: if you are already in that session, there is nothing to
# switch to.
find_candidates() {
  local current="" name entry path depth candidate dir
  local -A session_names=()

  if [[ -n ${TMUX:-} ]]; then
    current=$(tmux display-message -p '#S')
  fi

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    session_names["$name"]=1
    [[ "$name" == "$current" ]] && continue
    printf '[TMUX] %s\n' "$name"
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)

  for entry in "${TS_SEARCH_PATHS[@]}"; do
    depth="$TS_MAX_DEPTH"
    if [[ "$entry" =~ ^(.+):([0-9]+)$ ]]; then
      path="${BASH_REMATCH[1]}"
      depth="${BASH_REMATCH[2]}"
    else
      path="$entry"
    fi

    [[ -d "$path" ]] || continue

    # :0 means "exactly this directory", without scanning its children.
    if (( depth == 0 )); then
      candidate=$(basename "$path" | tr '.: ' '___')
      [[ -n "${session_names[$candidate]:-}" ]] && continue
      printf '%s\n' "$path"
      continue
    fi

    while IFS= read -r dir; do
      candidate=$(basename "$dir" | tr '.: ' '___')
      [[ -n "${session_names[$candidate]:-}" ]] && continue
      printf '%s\n' "$dir"
    done < <(find "$path" -mindepth 1 -maxdepth "$depth" \
      \( -name .git -o -name node_modules -o -name .venv -o -name __pycache__ -o -name target \) -prune -o \
      -type d -print 2>/dev/null)
  done
}

sanity_check

if [[ -n "${user_selected:-}" ]]; then
  selected="$user_selected"
else
  selected=$(find_candidates | fzf)
fi

[[ -z "${selected:-}" ]] && exit 0

# Picked an existing session from the list: just switch to it as-is.
if [[ "$selected" =~ ^\[TMUX\]\ (.+)$ ]]; then
  switch_to "${BASH_REMATCH[1]}"
  exit 0
fi

if [[ ! -d "$selected" ]]; then
  if has_session "$selected"; then
    switch_to "$selected"
    exit 0
  fi
  echo "Not a directory or existing session: $selected" >&2
  exit 1
fi

selected_dir=$(cd "$selected" && pwd)
session_name=$(basename "$selected_dir" | tr '.: ' '___')

apply_project_overrides "$selected_dir"

if has_session "$session_name"; then
  ensure_layout "$session_name" "$selected_dir"
else
  create_session "$session_name" "$selected_dir"
fi

switch_to "$session_name"
